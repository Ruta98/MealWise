<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MealWise.ViewModels"
             xmlns:models="clr-namespace:MealWise.Models"
             xmlns:converters="clr-namespace:MealWise.Converters"
             x:Class="MealWise.Views.PantryPage"
             x:DataType="vm:PantryViewModel"
             BackgroundColor="#0A110E"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CategoryToIconConverter x:Key="CategoryToIconConverter" />
            <converters:UnitToAbbreviationConverter x:Key="UnitToAbbreviationConverter" />

            <Color x:Key="BgColor">#0A110E</Color>
            <Color x:Key="CardBgColor">#13231C</Color>
            <Color x:Key="BorderColor">#1D362B</Color>
            <Color x:Key="AccentColor">#C8FF4D</Color>
            <Color x:Key="TextMutedColor">#8C9F97</Color>
            <Color x:Key="TextColor">#FFFFFF</Color>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBgColor}"/>
                <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Top Header & Back Button -->
        <VerticalStackLayout Grid.Row="0" Padding="20,16,20,12" Spacing="12">
         

            <!-- Titles -->
            <Label Text="Update ingredients"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextColor}"/>

            <Label Text="Add what's in your kitchen so we can tailor your plan."
                   FontSize="12"
                   TextColor="{StaticResource TextMutedColor}"
                   Margin="0,-4,0,0"/>
        </VerticalStackLayout>

        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,8,20,20" Spacing="16">

                <!-- Action Cards: Take Photo / Type It In -->
                <Grid ColumnDefinitions="*" ColumnSpacing="12">

                    <!-- 1. Take a Photo --><!--
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TakePhotoCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="36" HeightRequest="36" 
                                    BackgroundColor="#1C3A34" Stroke="Transparent" 
                                    StrokeShape="RoundRectangle 10" HorizontalOptions="Start">
                                <Label Text="📷" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Take a photo" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextColor}"/>
                            <Label Text="Snap your fridge or pantry" FontSize="11" TextColor="{StaticResource TextMutedColor}"/>
                        </VerticalStackLayout>
                    </Border>-->

                    <!-- 2. Type It In -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TypeInputCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Border WidthRequest="36" HeightRequest="36" 
                                    BackgroundColor="#1C3A34" Stroke="Transparent" 
                                    StrokeShape="RoundRectangle 10" HorizontalOptions="Start">
                                <Label Text="✏️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Type it in" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextColor}"/>
                            <Label Text="List ingredients by hand" FontSize="11" TextColor="{StaticResource TextMutedColor}"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- AI Processing State Card -->
                <Border Style="{StaticResource CardBorderStyle}" 
                        Padding="16" 
                        IsVisible="{Binding IsInterpreting}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" VerticalOptions="Center">
                        <ActivityIndicator Grid.Column="0" 
                                           IsRunning="{Binding IsInterpreting}" 
                                           Color="{StaticResource AccentColor}" 
                                           HeightRequest="28" 
                                           WidthRequest="28" 
                                           VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding StatusTitle, FallbackValue='Interpreting your input'}" 
                                   FontAttributes="Bold" 
                                   FontSize="13" 
                                   TextColor="{StaticResource TextColor}"/>
                            <Label Text="{Binding StatusSubtitle, FallbackValue='We will turn this into ingredients automatically'}" 
                                   FontSize="11"  TextColor="{StaticResource TextMutedColor}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Ingredients Section Header -->
                <Label Text="YOUR INGREDIENTS" 
                       FontSize="11" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource TextMutedColor}" 
                       CharacterSpacing="0.8" 
                       Margin="0,4,0,-4"/>

                <!-- Dynamic Ingredients List -->
                <VerticalStackLayout Spacing="10">
                    <BindableLayout.ItemsSource>
                        <Binding Path="PantryItems" />
                    </BindableLayout.ItemsSource>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PantryItem">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="14,12">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">

                                    <!-- Category Icon (Converted from ProductCategory) -->
                                    <Label Grid.Column="0" 
                                           Text="{Binding Category, Converter={StaticResource CategoryToIconConverter}}" 
                                           FontSize="18" 
                                           VerticalOptions="Center"/>

                                    <!-- Ingredient Name -->
                                    <Label Grid.Column="1" 
                                           Text="{Binding Name}" 
                                           FontAttributes="Bold" 
                                           FontSize="14" 
                                           TextColor="{StaticResource TextColor}" 
                                           VerticalOptions="Center"/>

                                    <!-- Quantity & Unit -->
                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding QuantityAmount}" 
                                               FontSize="12" 
                                               TextColor="{StaticResource TextMutedColor}"/>
                                        <Label Text="{Binding Unit, Converter={StaticResource UnitToAbbreviationConverter}}" 
                                               FontSize="12" 
                                               TextColor="{StaticResource TextMutedColor}"/>
                                    </HorizontalStackLayout>

                                    <!-- Remove Action via clean vector cross symbol -->
                                    <Label Grid.Column="3" 
                                           Text="✕" 
                                           TextColor="{StaticResource TextMutedColor}" 
                                           FontSize="16" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"
                                           Padding="6"
                                           Opacity="0.7">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PantryViewModel}}, Path=RemoveItemCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Label.GestureRecognizers>
                                    </Label>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <!-- AI Interactive Refinement Box -->
                <Border Style="{StaticResource CardBorderStyle}" 
        Padding="14,12" 
        IsVisible="{Binding IsReviewingDraft}"
        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Is this correct? Tell AI what to fix:" 
               FontSize="12" 
               FontAttributes="Bold" 
               TextColor="{StaticResource TextColor}"/>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <!-- Поле для введення невідповідностей -->
                            <Entry Grid.Column="0" 
                   Text="{Binding DiscrepancyText}"
                   Placeholder="e.g. 'There is no milk, and make apples 5 pieces'"
                   PlaceholderColor="#5A756C"
                   TextColor="{StaticResource TextColor}"
                   FontSize="12.5"
                   VerticalOptions="Center"/>

                            <!-- Кнопка коригування ШІ -->
                            <Button Grid.Column="1" 
                    Text="Fix with AI"
                    Command="{Binding RefineWithAiCommand}"
                    BackgroundColor="#1C3A34"
                    TextColor="{StaticResource AccentColor}"
                    BorderColor="{StaticResource BorderColor}"
                    BorderWidth="1"
                    FontSize="11"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="36"
                    Padding="14,0"
                    VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
                            
        </ScrollView>

        <!-- Save Button Footer -->
        <Border Grid.Row="2" BackgroundColor="#0A110E" Padding="20,12,20,24" StrokeThickness="0">
            <Button Text="Save to my kitchen"
                    Command="{Binding SaveToKitchenCommand}"
                    BackgroundColor="{StaticResource AccentColor}"
                    TextColor="#0E211F"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    HeightRequest="52"/>
        </Border>

    </Grid>
</ContentPage>